---
import Layout from "../layouts/Layout.astro";
import { parseApi } from "../parseApi";

const sources = import.meta.glob<string>("../../../src/**/*.ts", {
	eager: true,
	query: "?raw",
	import: "default",
});
const docs = parseApi(sources);
---

<Layout title="API reference · Succulent" activeNav="reference">
	<div class="docs">
		<aside class="docs-side" id="side"></aside>

		<main class="docs-main">
			<article class="prose" style="max-width: 820px">
				<div class="crumb">Docs <span class="sep">/</span> API reference</div>
				<h1>API reference</h1>
				<p class="sub">
					Every schema, operator and filter Succulent exports. Filter by kind,
					type to search, or hit <span class="kbd">⌘K</span> from anywhere to
					jump straight to a symbol.
				</p>

				<div class="api-filter" id="filter">
					<button data-k="all" class="active">All</button>
					<button data-k="schema">schemas</button>
					<button data-k="operator">operators</button>
					<button data-k="filter">filters</button>
					<button data-k="type">type helpers</button>
				</div>

				<div id="entries"></div>
			</article>
		</main>

		<aside class="docs-toc">
			<h5>Groups</h5>
			<nav id="toc"></nav>
		</aside>
	</div>

	{/* Server-rendered TSDoc payload, read by the bundled script below. */}
	<script
		type="application/json"
		id="succ-api-docs"
		set:html={JSON.stringify(docs).replace(/</g, "\\u003c")}
	/>

	<script>
		import { symbols, highlight, type SuccApiDoc, type SuccSymbolKind } from "../scripts/shared";

		const docsEl = document.getElementById("succ-api-docs");
		const docs: Record<string, SuccApiDoc> = docsEl?.textContent
			? JSON.parse(docsEl.textContent)
			: {};

		const EX: Record<string, string> = {
			guard: "guard(x, $string);",
			check: "check(x, $User);",
			is: "if (is(x, $number)) { /* x: number */ }",
			lazy: "friends: $Array(lazy(() => $Friend))",
			union: "union($string, $number) // string | number",
			or: "or($string, $number) // string | number",
			and: "and($Named, $Aged) // Named & Aged",
			oneOf: 'oneOf(["red", "green", "blue"])',
			CheckError:
				"try { guard(x, $User); } catch (e) {\n  if (e instanceof CheckError) {/* …*/}\n}",
			$tryinstanceof: "$tryinstanceof(() => Buffer)",
			$ArrayBufferView: "guard(buf, $ArrayBufferView);",
			$File: "guard(x, $File);",
			$Buffer: "guard(x, $Buffer);",
			$Request: "guard(x, $Request);",
			$Response: "guard(x, $Response);",
			matches: "$string.that(matches(/^[a-z0-9_]+$/))",
			inRange: "$int.that(inRange(0, 100))",
			hasLength: "$string.that(hasLength(8))",
			minLength: "$Array($int).that(minLength(1))",
			maxLength: "$string.that(maxLength(50))",
			nonEmpty: "$string.that(nonEmpty)",
			$string: "guard(x, $string);",
			$number: "guard(x, $number);",
			$int: "guard(x, $int);",
			$finite: "guard(x, $finite);",
			$bigint: "guard(x, $bigint);",
			$boolean: "guard(x, $boolean);",
			$symbol: "guard(x, $symbol);",
			$NaN: "guard(x, $NaN);",
			$literal: '$literal("draft") // the string "draft"',
			$optional: "$optional($string) // string | undefined",
			$maybe: "$maybe($Date) // Date | null | undefined",
			$nullish: "guard(x, $nullish);",
			$falsy: "guard(x, $falsy);",
			$any: "guard(x, $any); // always ok",
			$unknown: "guard(x, $unknown); // always ok, narrows to unknown",
			$never: "guard(x, $never); // always throws",
			$true: "guard(x, $true);",
			$false: "guard(x, $false);",
			$null: "guard(x, $null);",
			$undefined: "guard(x, $undefined);",
			$interface: "$interface({ name: $string, age: $int })",
			$Exact: "$Exact({ id: $string }) // no extra keys",
			$object: "guard(x, $object); // any non-null object",
			$Array: "$Array($number) // number[]",
			$Tuple: "$Tuple($string, $number) // [string, number]",
			$Record: "$Record($string, $int) // Record<string, number>",
			$Map: "$Map($string, $User) // Map<string, User>",
			$Set: "$Set($string) // Set<string>",
			$enum: "$enum(Color) // a TypeScript enum",
			$Date: "guard(x, $Date);",
			$RegExp: "guard(x, $RegExp);",
			$Error: "guard(x, $Error);",
			$URL: "guard(x, $URL);",
			$ArrayBuffer: "guard(buf, $ArrayBuffer);",
			$Blob: "guard(x, $Blob);",
			$instanceof: "$instanceof(MyClass) // an instance of MyClass",
			Type: "type User = Type<typeof $User>;",
			Schema: "const $F: Schema<Friend> = $interface({ /* … */ });",
		};
		const KIND_LABEL: Partial<Record<SuccSymbolKind, string>> = {
			schema: "schema",
			operator: "operator",
			filter: "filter",
			type: "type",
		};

		const syms = symbols.filter((s) => s.kind !== "page");
		const entriesEl = document.getElementById("entries")!;
		const sideEl = document.getElementById("side")!;
		const tocEl = document.getElementById("toc")!;

		const order = [
			"Operators",
			"Filters",
			"Primitives",
			"Special",
			"Objects & collections",
			"Built-ins",
			"Typed arrays",
			"Type helpers",
		];
		const groups: Record<string, typeof syms> = {};
		syms.forEach((s) => {
			(groups[s.group] = groups[s.group] || []).push(s);
		});

		let sideHtml =
			'<button class="search-trigger side-search" data-cmdk>' +
			'<svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/></svg>' +
			'<span class="label">Search</span><span class="kbd">⌘K</span></button>';
		order.forEach((g) => {
			if (!groups[g]) return;
			sideHtml +=
				`<div class="grp"><h5>${g}</h5>` +
				groups[g]!
					.map((s) => `<a class="mono" href="#api-${s.name}">${s.name}</a>`)
					.join("") +
				"</div>";
		});
		sideEl.innerHTML = sideHtml;

		tocEl.innerHTML = order
			.filter((g) => groups[g])
			.map((g) => `<a href="#grp-${g.replace(/[^a-z]/gi, "")}">${g}</a>`)
			.join("");

		const escapeHtml = (s: string) =>
			s.replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;");

		// Lightweight inline-markdown: convert `code` to <code class="inl">,
		// split paragraphs on blank lines.
		const renderProse = (text: string) => {
			if (!text) return "";
			return text
				.split(/\n{2,}/)
				.map((para) => {
					let safe = escapeHtml(para);
					safe = safe.replace(
						/`([^`]+)`/g,
						(_, c) => `<code class="inl">${c}</code>`,
					);
					return `<p>${safe.replace(/\n/g, " ")}</p>`;
				})
				.join("");
		};

		let html = "";
		order.forEach((g) => {
			if (!groups[g]) return;
			html += `<h2 class="api-group-title" id="grp-${g.replace(/[^a-z]/gi, "")}">${g}</h2>`;
			groups[g]!.forEach((s) => {
				const doc = docs[s.name] ?? null;
				const example =
					(doc && doc.examples[0]) || EX[s.name] || `guard(x, ${s.name});`;
				html +=
					`<div class="api-entry" id="api-${s.name}">` +
					`<div class="sig-row"><span class="sig">${highlight(s.sig || s.name)}</span>` +
					`<span class="kindtag">${KIND_LABEL[s.kind] ?? s.kind}</span></div>` +
					`<p class="blurb">${s.blurb}</p>`;
				if (doc?.description) {
					html += `<div class="desc">${renderProse(doc.description)}</div>`;
				}
				if (doc?.remarks) {
					html += `<div class="desc">${renderProse(doc.remarks)}</div>`;
				}
				html +=
					`<div class="code ex"><pre><code>${highlight(example)}</code></pre></div>` +
					"</div>";
			});
		});
		entriesEl.innerHTML = html;

		const filterBtns = Array.from(
			document.querySelectorAll<HTMLButtonElement>("#filter button"),
		);
		filterBtns.forEach((b) => {
			b.addEventListener("click", () => {
				filterBtns.forEach((x) => x.classList.remove("active"));
				b.classList.add("active");
				const k = b.dataset["k"];
				document.querySelectorAll<HTMLElement>(".api-entry").forEach((e) => {
					const name = e.id.replace("api-", "");
					const sym = syms.find((s) => s.name === name);
					e.style.display =
						k === "all" || (sym && sym.kind === k) ? "" : "none";
				});
				document
					.querySelectorAll<HTMLElement>(".api-group-title")
					.forEach((t) => {
						let any = false;
						let n = t.nextElementSibling;
						while (n && !n.classList.contains("api-group-title")) {
							if (
								n.classList.contains("api-entry") &&
								(n as HTMLElement).style.display !== "none"
							)
								any = true;
							n = n.nextElementSibling;
						}
						t.style.display = any ? "" : "none";
					});
			});
		});

		if (location.hash) {
			const t = document.getElementById(location.hash.slice(1));
			if (t) {
				t.classList.add("flash");
				setTimeout(() => t.classList.remove("flash"), 1400);
			}
		}

		const tl = Array.from(tocEl.querySelectorAll<HTMLAnchorElement>("a"));
		const th = tl.map((a) =>
			document.getElementById(a.getAttribute("href")!.slice(1)),
		);
		window.addEventListener("scroll", () => {
			const y = window.scrollY + 110;
			let cur = 0;
			th.forEach((h, i) => {
				if (h && h.offsetTop <= y) cur = i;
			});
			tl.forEach((a, i) => a.classList.toggle("active", i === cur));
		});
	</script>
</Layout>
