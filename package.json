{
	"name": "succulent",
	"version": "0.21.0",
	"author": "McKayla Washburn-Love <kayla@tree.camp>",
	"description": "Powerful and easy runtime type checking",
	"keywords": [
		"typescript",
		"type checking",
		"validation",
		"types",
		"type safety",
		"runtypes",
		"yup",
		"zod"
	],
	"license": "MIT",
	"homepage": "https://github.com/aslilac/succulent",
	"repository": "https://github.com/aslilac/succulent",
	"bugs": "https://github.com/aslilac/succulent/issues",
	"type": "module",
	"main": "./build/index.js",
	"types": "./build/index.d.ts",
	"exports": {
		"import": "./build/index.js",
		"types": "./build/index.d.ts"
	},
	"files": [
		"build/**"
	],
	"devDependencies": {
		"@types/node": "^25.9.1",
		"prettier": "~3.8.3",
		"typescript": "~6.0.3",
		"vitest": "^4.1.8"
	},
	"scripts": {
		"build": "tsc -b tsconfig.build.json",
		"fmt": "prettier --write .",
		"prepack": "$npm_execpath run build -s",
		"test": "vitest run",
		"type-check": "tsc -b ."
	},
	"packageManager": "pnpm@11.5.1+sha512.93f7b57422ea7068257235b4c16eb60762eb68e1dc23723199cc739043ea9be2c4143274a399d8c6defa2b1176226d9ca1c4b63482d6200c1a8fbaa78c1d1485"
}
